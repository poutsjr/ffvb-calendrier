# Variables d'environnement : à renseigner dans Vercel (Settings > Environment Variables), JAMAIS dans le dépôt.
# En local, copier ce fichier en .env (ignoré par git).

# Base Neon : ajoutée automatiquement par l'intégration Vercel Marketplace (ou à copier depuis le tableau de bord Neon).
DATABASE_URL=

# Connexion Google (console.cloud.google.com > API et services > Identifiants > ID client OAuth, type « Application Web »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresse publique du site, sans « / » final (ex. https://ffvb-calendrier.vercel.app). Sert d'URI de redirection Google.
APP_URL=

# Secret de signature des sessions : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
SESSION_SECRET=

# Secret de la tâche quotidienne : Vercel l'envoie dans l'en-tête Authorization des appels cron (`openssl rand -base64 32`)
CRON_SECRET=

# Comptes Google administrateurs (séparés par des virgules). Toujours admin, quoi qu'il y ait en base.
ADMIN_EMAILS=

# --- Développement local uniquement (ignorés sur Vercel) ---
# DEV_LOGIN=1     permet /api/auth/login?dev=adresse@exemple.fr sans Google
# PGLITE_DIR=.pglite   base locale persistante (sinon en mémoire)
